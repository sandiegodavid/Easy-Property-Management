# Pinned linux/amd64 infrastructure candidate; normal application startup unavailable.
FROM docker.io/library/python@sha256:1faf2343e747208b2a36e5f2b5ff908ec3b2d0078a6a7bfe73b535698fe83909 AS installed
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY . /input
RUN python /input/verify_build_inputs.py /input
RUN python -m venv --copies --without-pip /opt/epm/venv
RUN python -m pip --python /opt/epm/venv/bin/python install --no-index --no-compile --find-links=/input/wheelhouse --require-hashes -r /input/dependencies.lock
RUN python -m pip --python /opt/epm/venv/bin/python install --no-index --no-deps --no-compile /input/*.whl
RUN /opt/epm/venv/bin/python -B /input/stage_schema_resources.py /input/resources --component admin
RUN /opt/epm/venv/bin/python -B /input/verify_installation.py --component admin
RUN python -m pip --python /opt/epm/venv/bin/python check

FROM docker.io/library/python@sha256:1faf2343e747208b2a36e5f2b5ff908ec3b2d0078a6a7bfe73b535698fe83909
COPY --from=installed /opt/epm/venv /opt/epm/venv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_INDEX=1
WORKDIR /opt/epm
USER 65532:65532
LABEL epm.component="admin" epm.acceptance="infrastructure_candidate" epm.runtime="unavailable"
HEALTHCHECK --interval=30s --timeout=3s CMD ["/opt/epm/venv/bin/python", "-B", "-c", "import http.client; c=http.client.HTTPConnection('127.0.0.1',8000,timeout=2); c.request('GET','/health/live'); assert c.getresponse().status==200"]
ENTRYPOINT ["/opt/epm/venv/bin/python", "-B", "-m", "app.hosted_candidates.admin"]
CMD ["--health-only"]
