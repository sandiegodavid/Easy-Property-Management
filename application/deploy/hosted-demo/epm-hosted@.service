[Unit]
Description=EPM protected hosted demo %i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/epm-%i/volume
Conflicts=epm@%i.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=epm-%i
Group=epm-%i
WorkingDirectory=/var/lib/epm-%i
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/var/lib/epm-%i/volume/tmp
EnvironmentFile=/etc/epm/hosted-%i.env
# Replace HOSTED_RELEASE with the exact qualified root-owned release directory.
ExecStart=/opt/epm/releases/HOSTED_RELEASE/venv/bin/python -m app --config /var/lib/epm-%i/config.json serve-hosted --deployment /etc/epm/hosted-%i.json --port ${EPM_PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
ReadWritePaths=/var/lib/epm-%i/volume /var/lib/epm-%i/access
MemoryHigh=1G
MemoryMax=1500M
CPUQuota=90%

[Install]
WantedBy=multi-user.target
