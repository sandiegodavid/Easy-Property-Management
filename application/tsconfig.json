{
  "extends": "./tsconfig.base.json",
  "include": [
    "*.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/web/**/*.mts",
    "apps/web/**/*.cts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.mts",
    "packages/**/*.cts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.cts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/coverage"]
}
